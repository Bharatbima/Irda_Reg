.env
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/

# Extracted JSON files ARE committed (prebuilt from PDFs so Railway doesn't need them)
# Only exclude the source PDFs themselves (too large)
extracted/*.pdf

# Persistent data volume — managed by Railway, not committed
data/

# Source PDFs — large files, share out-of-band
source_docs/*.pdf
