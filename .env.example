# Copy to .env for local development. Never commit .env.

# Required: Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Required: Session signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-a-long-random-string

# Required: 6-digit code → email mapping (JSON string)
# Format: {"CODE": "email@domain.com", ...}
USER_CODES={"123456":"alice@bharatbima.co","234567":"bob@bharatbima.co","345678":"charlie@bharatbima.co","456789":"diana@bharatbima.co","567890":"eve@bharatbima.co","678901":"frank@bharatbima.co"}

# Optional: directory for persistent data (submissions.json lives here)
# On Railway, set this to the volume mount path, e.g. /data
DATA_DIR=data

# Optional: set to "true" to allow non-HTTPS cookies (local dev only)
DEBUG=true
